<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.springboottext.mapper.TagsMapper">

    <insert id="insert"  >
        INSERT INTO tags
        <trim prefix="(" suffix=")" suffixOverrides=",">
                <if test="tagName != null">
                    tag_name,
                </if>
                <if test="articleId != null">
                    article_id,
                </if>
                <if test="creatime != null">
                    creatime,
                </if>
                <if test="updatatime != null">
                    updatatime,
                </if>
        </trim>
        VALUES
        <trim prefix="(" suffix=")" suffixOverrides=",">
                <if test="tagName != null">
                    #{tagName},
                </if>
                <if test="articleId != null">
                    #{articleId},
                </if>
                <if test="creatime != null">
                    #{creatime},
                </if>
                <if test="updatatime != null">
                    #{updatatime},
                </if>
        </trim>
    </insert>
<!--多行插入-->
    <insert id="insertList" >
        INSERT INTO tags (tag_name, article_id)
        VALUES
        <foreach collection="list" index="index" item="item" open="(" separator="),(" close=")">
            #{item}, #{id}
        </foreach>
    </insert>

    <update id="updateByid">
        UPDATE tags
        <set>
                    <if test="tagName != null">
                        tag_name = #{tagName}
                           <if test="articleId != null or creatime != null or updatatime != null">,</if>
                    </if>
                    <if test="articleId != null">
                        article_id = #{articleId}
                           <if test="creatime != null or updatatime != null">,</if>
                    </if>
                    <if test="creatime != null">
                        creatime = #{creatime}
                           <if test="updatatime != null">,</if>
                    </if>
                    <if test="updatatime != null">
                        updatatime = #{updatatime}
                    </if>
        </set>
        <where>
                    id = #{id}
        </where>
    </update>
</mapper>
