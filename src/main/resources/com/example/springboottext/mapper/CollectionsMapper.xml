<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.springboottext.mapper.CollectionsMapper">

    <insert id="insert">
        INSERT INTO collections
        <trim prefix="(" suffix=")" suffixOverrides=",">
                <if test="id != null">
                    id,
                </if>
                <if test="articleId != null">
                    article_id,
                </if>
                <if test="compilationid != null">
                    compilationid,
                </if>
                <if test="userId != null">
                    user_id,
                </if>
                <if test="creatime != null">
                    creatime,
                </if>
                <if test="updatedtime != null">
                    updatedtime,
                </if>
                <if test="status != null">
                    status,
                </if>
        </trim>
        VALUES
        <trim prefix="(" suffix=")" suffixOverrides=",">
                <if test="id != null">
                    #{id},
                </if>
                <if test="articleId != null">
                    #{articleId},
                </if>
                <if test="compilationid != null">
                    #{compilationid},
                </if>
                <if test="userId != null">
                    #{userId},
                </if>
                <if test="creatime != null">
                    #{creatime},
                </if>
                <if test="updatedtime != null">
                    #{updatedtime},
                </if>
                <if test="status != null">
                    #{status},
                </if>
        </trim>
    </insert>

    <insert id="insertList" >
        INSERT INTO collections
        (article_id, compilationid , user_id)
        VALUES
        <foreach collection="list" item="item" separator=",">
            (#{item.articleId}, #{item.compilationid},#{item.userId})
        </foreach>
    </insert>

    <update id="updateByid">
        UPDATE collections
        <set>
                    <if test="articleId != null">
                        article_id = #{articleId}
                           <if test="compilationid != null or userId != null or creatime != null or updatedtime != null or status != null">,</if>
                    </if>
                    <if test="compilationid != null">
                        compilationid = #{compilationid}
                           <if test="userId != null or creatime != null or updatedtime != null or status != null">,</if>
                    </if>
                    <if test="userId != null">
                        user_id = #{userId}
                           <if test="creatime != null or updatedtime != null or status != null">,</if>
                    </if>
                    <if test="creatime != null">
                        creatime = #{creatime}
                           <if test="updatedtime != null or status != null">,</if>
                    </if>
                    <if test="updatedtime != null">
                        updatedtime = #{updatedtime}
                           <if test="status != null">,</if>
                    </if>
                    <if test="status != null">
                        status = #{status}
                    </if>
        </set>
        <where>
                    id = #{id}
        </where>
    </update>
</mapper>
